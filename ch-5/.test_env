STREAM_RECONNECTION_DELAY=100ms
#If running on local machine and connecting to Docker Scylla cluster (rather than testing within Docker) change SCYLLA_HOSTS to localhost
SCYLLA_HOSTS=scylla-node1,scylla-node2,scylla-node3
SCYLLA_KEYSPACE=wikistats_test
SCYLLA_CLUSTER_TIMEOUT=30
REDPANDA_REPLICATION=1
REDPANDA_HOST=redpanda-node1:9092
